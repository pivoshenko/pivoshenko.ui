{
  "name": "pivoshenko.ui",
  "version": "0.9.3",
  "description": "Shared frontend artifacts for the pivoshenko sites (Biome config, TS base, Tailwind preset, React components)",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Volodymyr Pivoshenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pivoshenko/pivoshenko.ui.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "files": ["config", "tailwind-preset", "ui", "postcss.config.mjs"],
  "exports": {
    "./package.json": "./package.json",
    "./biome.json": "./config/biome.json",
    "./tsconfig.base.json": "./config/tsconfig.base.json",
    "./tailwind-preset": {
      "types": "./tailwind-preset/index.d.ts",
      "default": "./tailwind-preset/index.js"
    },
    "./tailwind-preset/site": {
      "types": "./tailwind-preset/site.d.ts",
      "default": "./tailwind-preset/site.js"
    },
    "./globals.css": "./ui/globals.css",
    "./next/icon": "./ui/next/icon.tsx",
    "./next/opengraph-image": "./ui/next/opengraph-image.tsx",
    "./next/config": "./ui/next/config.ts",
    "./next/site-layout": "./ui/next/site-layout.tsx",
    "./postcss.config.mjs": "./postcss.config.mjs",
    ".": "./ui/src/index.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0"
  },
  "peerDependencies": {
    "@vercel/analytics": "^1.0.0 || ^2.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@vercel/analytics": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^19.2.18",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  }
}
